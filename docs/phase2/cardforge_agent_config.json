{
  "orchestration": {
    "enabled": true,
    "ollama_url": "http://localhost:11434",
    "fallback_to_claude_mcp": true,
    "max_retries": 3,
    "timeout_seconds": 300
  },
  
  "models": {
    "router": "llama3.2:3b",
    "deck_optimizer": "qwen2.5-coder:7b",
    "price_analyzer": "llama3.2:3b",
    "collection_manager": "gemma2:4b",
    "buy_list_generator": "qwen2.5-coder:7b",
    "meta_analyzer": "llama3.1:70b",
    "synergy_finder": "qwen2.5-coder:7b",
    
    "alternatives": {
      "fast": ["phi3:mini", "tinyllama"],
      "code": ["deepseek-coder:6.7b", "granite-code:8b", "codellama:13b"],
      "embedding": ["all-minilm", "nomic-embed-text"]
    }
  },
  
  "agent_settings": {
    "temperature": 0.7,
    "max_tokens": 2000,
    "confidence_threshold": 0.6,
    
    "deck_optimization": {
      "focus_areas": [
        "mana_curve",
        "ramp_sources",
        "card_synergies",
        "win_conditions",
        "protection_suite"
      ],
      "turn_3_commander_ramp_target": 12,
      "budget_threshold": 10.0
    },
    
    "buy_list_generation": {
      "priority_weights": {
        "commander": 1,
        "protection": 2,
        "ramp": 2,
        "removal": 3,
        "finisher": 3,
        "card_draw": 3,
        "utility": 4,
        "land": 4,
        "sideboard": 5
      },
      "max_price_per_card": 50.0,
      "prefer_budget_alternatives": true
    },
    
    "collection_management": {
      "duplicate_thresholds": {
        "common": 4,
        "uncommon": 4,
        "rare": 2,
        "mythic": 2
      },
      "min_value_for_protection": 20.0,
      "trade_fodder_min_value": 5.0
    }
  },
  
  "performance": {
    "cache_enabled": true,
    "cache_ttl_hours": 24,
    "parallel_agents": false,
    "log_level": "INFO"
  },
  
  "integration": {
    "cardforge_database": "data/collections/main.db",
    "export_directory": "data/exports/ai_reports",
    "backup_before_modifications": true
  },
  
  "teaching_mode": {
    "enabled": true,
    "explain_reasoning": true,
    "show_big_o_analysis": true,
    "socratic_questions": true,
    "curriculum_alignment": "AI_Orchestrator"
  }
}
