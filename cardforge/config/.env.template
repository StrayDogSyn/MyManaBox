# ============================================================================
# CARDFORGE ENVIRONMENT CONFIGURATION TEMPLATE
# Magic: The Gathering Collection Management Platform
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# SQLite is default, no configuration needed for basic use
# For PostgreSQL (future): uncomment and configure
# DATABASE_URL=postgresql://user:password@localhost:5432/cardforge
DATABASE_PATH=data/cardforge.db

# ----------------------------------------------------------------------------
# SCRYFALL API (Primary Data Source)
# ----------------------------------------------------------------------------
# No API key required - Scryfall is free!
# Rate limit: 10 requests/second (enforced by client)
SCRYFALL_RATE_LIMIT=10
SCRYFALL_CACHE_TTL=86400
SCRYFALL_PRICE_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# TCGPLAYER API (Enhanced Pricing)
# ----------------------------------------------------------------------------
# Get your API key at: https://developer.tcgplayer.com/
# Required for: Real-time market prices, buylist prices
TCGPLAYER_API_KEY=
TCGPLAYER_API_SECRET=
TCGPLAYER_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# CARD KINGDOM (Buylist Prices)
# ----------------------------------------------------------------------------
# No API available - uses web scraping
# Set to 'true' to enable Card Kingdom price lookups
CARDKINGDOM_ENABLED=true

# ----------------------------------------------------------------------------
# CARDMARKET API (European Pricing)
# ----------------------------------------------------------------------------
# Get your API key at: https://www.cardmarket.com/en/Magic/API
# Required for: European market prices
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=

# ----------------------------------------------------------------------------
# MOXFIELD INTEGRATION
# ----------------------------------------------------------------------------
# For deck sync and collection export
# Get your API key from Moxfield account settings
MOXFIELD_API_KEY=
MOXFIELD_USERNAME=

# ----------------------------------------------------------------------------
# ARCHIDEKT INTEGRATION (Future)
# ----------------------------------------------------------------------------
ARCHIDEKT_API_KEY=

# ----------------------------------------------------------------------------
# GOOGLE DRIVE BACKUP
# ----------------------------------------------------------------------------
# For automated cloud backups
# Get credentials at: https://console.cloud.google.com/
# Required: Enable Google Drive API, create OAuth 2.0 credentials
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google_credentials.json
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_ENABLED=false

# ----------------------------------------------------------------------------
# CLAUDE MCP INTEGRATION
# ----------------------------------------------------------------------------
# No API key needed - MCP uses local server
# Configure Claude Desktop to connect to CardForge MCP server
MCP_SERVER_PORT=8765
MCP_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# EDHREC DATA (Deck Recommendations)
# ----------------------------------------------------------------------------
# No API available - uses web scraping for recommendations
EDHREC_ENABLED=true
EDHREC_CACHE_TTL=604800

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO
LOG_FILE=data/cardforge.log

# Default collection settings
DEFAULT_COLLECTION_NAME=Main Collection
DEFAULT_CURRENCY=USD

# Price thresholds for analytics
BULK_PRICE_THRESHOLD=1.00
HIGH_VALUE_THRESHOLD=10.00
PREMIUM_VALUE_THRESHOLD=50.00

# Foil premium multiplier (TCGPlayer-style)
FOIL_PREMIUM_MULTIPLIER=5.40

# Automation settings
AUTO_PRICE_UPDATE_ENABLED=true
AUTO_PRICE_UPDATE_HOUR=6
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# ----------------------------------------------------------------------------
DEBUG=false
TESTING=false

# ============================================================================
# API KEY ACQUISITION CHECKLIST
# ============================================================================
# [ ] Scryfall - No key needed (free)
# [ ] TCGPlayer - https://developer.tcgplayer.com/ (free tier available)
# [ ] CardMarket - https://www.cardmarket.com/en/Magic/API (for EU)
# [ ] Moxfield - Account settings page
# [ ] Google Drive - https://console.cloud.google.com/ (for backups)
# ============================================================================
